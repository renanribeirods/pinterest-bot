# Copie para .env para rodar localmente. No GitHub, cadastre como Secrets/Variables.
# --- Refill local (seu PC, Claude Code com a sua assinatura) ---
LOCAL_CLAUDE_MODEL=opus
REFILL_MIN_DAYS=5
REFILL_MAX_PRODUCTS=15
RUNS_PER_DAY=4
# CLAUDE_BIN=C:\caminho\para\claude.exe   (opcional: detectado automaticamente)

# --- Sincronização com a loja Etsy (API oficial, gratuita) ---
ETSY_API_KEY=
ETSY_SHARED_SECRET=

# --- O que fazer no Actions se a fila acabar: template | skip | api ---
EMPTY_QUEUE_POLICY=template
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
PUBLISH_CHANNELS=webhook,api
PIN_WEBHOOK_URL=
PIN_WEBHOOK_SECRET=
IMAGE_HOST=imgbb
IMGBB_API_KEY=
PINTEREST_ACCESS_TOKEN=
PINTEREST_REFRESH_TOKEN=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_BOARD_ID=
PINTEREST_BOARD_MAP={"tpt":"","tes":"","notion":"","etsy":""}
PINS_PER_RUN=2
DRY_RUN=false

# --- Avisos de erro no celular (app ntfy) ---
NTFY_TOPIC=
